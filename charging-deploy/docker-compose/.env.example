# Domain and TLS
DOMAIN=charge.example.com
TLS_CERT=/etc/letsencrypt/live/charge.example.com/fullchain.pem
TLS_KEY=/etc/letsencrypt/live/charge.example.com/privkey.pem

# Database
DB_DSN=host=postgres user=opencharge password=changeMe dbname=opencharge sslmode=disable
DB_USER=opencharge
DB_PASSWORD=changeMe

# Middleware
REDIS_ADDR=redis:6379
KAFKA_BROKERS=kafka:9092

# Payment (WeChat service provider)
WX_MCH_ID=your_mch_id
WX_APP_ID=your_app_id
